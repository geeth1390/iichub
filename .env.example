# ---------------------------------------------------------------
# IICHUB settings. Copy to .env for local runs; on Dokploy paste
# these into the app's Environment tab. Never commit real values.
# ---------------------------------------------------------------

# Database. On Dokploy use the PostgreSQL service's *Internal* URL.
DATABASE_URL=postgresql://iichub:CHANGE_ME@iichub-iichubdb-xxxxx:5432/iichub
# disable = Dokploy private network. require = hosted DBs like Supabase.
DATABASE_SSL=disable

# Public address, no trailing slash. Visitors to iichub.com are sent here.
SITE_URL=https://www.iichub.com

# Signs sign-in sessions. 64 random characters: openssl rand -hex 32
JWT_SECRET=

# First super admin. Used only while no super admin exists.
# Password: 14+ characters. You must change it at first sign-in;
# then delete SUPERADMIN_PASSWORD from the environment.
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
SUPERADMIN_PASSWORD=

# Load the sample catalogue (66 machines in 6 states) into an EMPTY
# database, and show a "sample data" ribbon. Set false for real data only.
SEED_DEMO=true
# HIDE_SAMPLE_NOTICE=true   # hide the ribbon once the data is real

# Email (password reset, email confirmation, job updates) via resend.com.
# Without these the site works, but admins reset passwords by hand.
RESEND_API_KEY=
EMAIL_FROM=IICHUB <noreply@iichub.com>

# Optional
# PORT=3000
# LOG_LEVEL=info
# RUN_WORKER=true        # send notifications from the web process
# TRUST_PROXY=loopback,linklocal,uniquelocal
